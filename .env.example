# Timlee — every setting the Go binaries read, with a development value.
#
# Local development: `go run ./cmd/timlee-dev` sets the addresses, origins,
# secrets and allowlist itself. To run a binary by hand, copy this file to
# .env (git-ignored), edit it, and load it into the shell:
#
#   cp .env.example .env && set -a && . ./.env && set +a
#
# An empty value means "use the built-in default", which outside production
# is development-shaped. Never commit a .env holding real values.

# ── Environment ──────────────────────────────────────────────────────────────

# development | test | production. Only "production" turns on the startup checks that refuse weak secrets, http origins, dev sign-in and a mail outbox.
TIMLEE_ENV=development
# Read BEFORE TIMLEE_ENV and wins if set. Leave it unset.
#NODE_ENV=
# debug | info | warn | error for timlee-auth. Empty: debug outside production, info in it.
LOG_LEVEL=

# ── Listen addresses (loopback by default) ──────────────────────────────────

# timlee-web, the server-rendered site.
TIMLEE_WEB_ADDR=127.0.0.1:5173
# timlee-auth, the control plane: sessions, sign-in, organisations, API keys, allowlist, the database.
TIMLEE_CONTROL_ADDR=127.0.0.1:8788

# ── Origins: what a browser uses ─────────────────────────────────────────────

# The site's public origin. Must be https:// in production. No trailing slash.
TIMLEE_PUBLIC_ORIGIN=http://localhost:5173
# Where browsers and timlee-web reach timlee-auth; also builds OAuth callbacks. https:// in production.
TIMLEE_CONTROL_ORIGIN=http://127.0.0.1:8788

# ── Secrets ─────────────────────────────────────────────────────────────────

# HMAC key for the session cookie. Empty: a development default production refuses. Production: openssl rand -hex 32.
SESSION_SECRET=
# Shared secret for service-to-service /internal/verify-* calls on timlee-auth, at least 32 characters.
TIMLEE_INTERNAL_TOKEN=

# ── Prompt allowlist ────────────────────────────────────────────────────────

# Comma-separated, case-insensitive account emails allowed to submit prompts. Empty allows NOBODY (fails closed).
# timlee-dev defaults it to the development account dev@timlee.local when unset.
TIMLEE_ALLOWED_EMAILS=

# ── State ────────────────────────────────────────────────────────────────────

# The control plane's SQLite file (WAL mode).
TIMLEE_DB=.local/data/timlee.db
# Rolling browser session lifetime, Go duration syntax: 336h is 14 days.
TIMLEE_SESSION_TTL=336h
# Development only: magic-link emails are written here instead of being sent. Empty: .local/mail outside production.
TIMLEE_MAIL_OUTBOX=

# ── The proxy ────────────────────────────────────────────────────────────────

# Believe X-Forwarded-For/-Proto. Only true behind a trusted reverse proxy.
TIMLEE_TRUST_PROXY=false

# ── Sign-in ──────────────────────────────────────────────────────────────────

# Password-less development sign-in. Empty: on outside production, off in it.
TIMLEE_ALLOW_DEV_LOGIN=
# OAuth providers: each needs both halves or its button does not appear. Callback: ${TIMLEE_CONTROL_ORIGIN}/auth/<provider>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ── Locales ──────────────────────────────────────────────────────────────────

# Comma-separated locale IDs timlee-web serves. Default: en.
TIMLEE_LOCALES=en
# Adds the en-xa and ar-xb pseudo-locales for testing. Never in production.
TIMLEE_PSEUDO_LOCALES=false

# ── timlee-web development ───────────────────────────────────────────────────

# Directory of built assets to serve instead of the tree embedded in the binary. Empty: embedded.
TIMLEE_ASSET_DIR=
# Re-read templates from disk on every request (same as -dev).
TIMLEE_WEB_DEV=false
# Template directory used when TIMLEE_WEB_DEV=true. Empty: web/templates.
TIMLEE_TEMPLATE_DIR=

# ── App workspace (internal/appfactory, timlee-web) ─────────────────────────
# The Bazel monorepo generated apps live in. timlee-dev sets it to ./workspace.
# If it is missing, /apps is not served.
TIMLEE_WORKSPACE=workspace
# The preview server: each app's last good build, framed by the workspace page.
# Must be a different SITE from TIMLEE_PUBLIC_ORIGIN and TIMLEE_CONTROL_ORIGIN
# (enforced in production). timlee-dev uses http://preview.localhost:<web+1>.
TIMLEE_PREVIEW_ADDR=127.0.0.1:5174
TIMLEE_PREVIEW_ORIGIN=http://preview.localhost:5174
# Copilot CLI model for prompts (empty: the CLI default).
TIMLEE_COPILOT_MODEL=
# AI credits one prompt may spend (copilot --max-ai-credits). Required in production.
TIMLEE_COPILOT_MAX_AI_CREDITS=
