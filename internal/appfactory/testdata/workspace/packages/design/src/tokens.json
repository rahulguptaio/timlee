{
  "$comment": "Editable design knobs. The Timlee editor renders one control per token; defaults mirror theme.css. Fonts are self-hosted npm packages bundled into each app (no third-party requests); `imports` lists every weight Web Awesome uses (400/500/600) so nothing is faux-bolded, and `vars` adjusts weights for single-weight faces. Timlee rejects color choices that fail WCAG contrast (see `contrast`).",
  "fonts": [
    {
      "family": "Helvetica",
      "stack": "Helvetica, \"Helvetica Neue\", Arial, sans-serif"
    },
    {
      "family": "Inter",
      "stack": "\"Inter Variable\", Helvetica, Arial, sans-serif",
      "imports": [
        "@fontsource-variable/inter"
      ]
    },
    {
      "family": "IBM Plex Sans",
      "stack": "\"IBM Plex Sans\", Helvetica, Arial, sans-serif",
      "imports": [
        "@fontsource/ibm-plex-sans/400.css",
        "@fontsource/ibm-plex-sans/500.css",
        "@fontsource/ibm-plex-sans/600.css"
      ]
    },
    {
      "family": "Space Grotesk",
      "stack": "\"Space Grotesk Variable\", Helvetica, Arial, sans-serif",
      "imports": [
        "@fontsource-variable/space-grotesk"
      ]
    },
    {
      "family": "Fraunces",
      "stack": "\"Fraunces Variable\", Georgia, serif",
      "imports": [
        "@fontsource-variable/fraunces"
      ]
    },
    {
      "family": "DM Serif Display",
      "stack": "\"DM Serif Display\", Georgia, serif",
      "imports": [
        "@fontsource/dm-serif-display/400.css"
      ],
      "vars": {
        "--wa-font-weight-semibold": "400",
        "--wa-font-weight-bold": "400"
      }
    },
    {
      "family": "JetBrains Mono",
      "stack": "\"JetBrains Mono Variable\", ui-monospace, monospace",
      "imports": [
        "@fontsource-variable/jetbrains-mono"
      ]
    }
  ],
  "tokens": [
    {
      "name": "--timlee-brand",
      "label": "Brand",
      "type": "color",
      "light": "#cc3a12",
      "dark": "#ff6a3d"
    },
    {
      "name": "--timlee-brand-on",
      "label": "Text on brand",
      "type": "color",
      "light": "#ffffff",
      "dark": "#140603"
    },
    {
      "name": "--timlee-surface",
      "label": "Background",
      "type": "color",
      "light": "#fbfaf8",
      "dark": "#0f0f10"
    },
    {
      "name": "--timlee-surface-raised",
      "label": "Raised surface",
      "type": "color",
      "light": "#ffffff",
      "dark": "#19191b"
    },
    {
      "name": "--timlee-border",
      "label": "Border",
      "type": "color",
      "light": "#e4e1dc",
      "dark": "#2c2c2f"
    },
    {
      "name": "--timlee-text",
      "label": "Text",
      "type": "color",
      "light": "#141414",
      "dark": "#f3f1ee"
    },
    {
      "name": "--timlee-text-quiet",
      "label": "Quiet text",
      "type": "color",
      "light": "#5f5c58",
      "dark": "#a29f9a"
    },
    {
      "name": "--timlee-radius-scale",
      "label": "Corner roundness",
      "type": "number",
      "min": 0,
      "max": 3,
      "step": 0.25,
      "light": "0.75",
      "dark": "0.75"
    },
    {
      "name": "--timlee-space-scale",
      "label": "Spacing",
      "type": "number",
      "min": 0.75,
      "max": 1.5,
      "step": 0.05,
      "light": "1",
      "dark": "1"
    }
  ],
  "contrast": [
    {
      "fg": "--timlee-brand-on",
      "bg": "--timlee-brand",
      "min": 4.5
    },
    {
      "fg": "--timlee-text",
      "bg": "--timlee-surface",
      "min": 4.5
    },
    {
      "fg": "--timlee-text",
      "bg": "--timlee-surface-raised",
      "min": 4.5
    },
    {
      "fg": "--timlee-text-quiet",
      "bg": "--timlee-surface",
      "min": 4.5
    },
    {
      "fg": "--timlee-text-quiet",
      "bg": "--timlee-surface-raised",
      "min": 4.5
    },
    {
      "fg": "--timlee-brand",
      "bg": "--timlee-surface",
      "min": 3
    }
  ]
}
