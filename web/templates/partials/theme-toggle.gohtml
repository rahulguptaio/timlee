{{- /*
  The theme toggle. Without a choice the page follows the reader's system
  setting; the toggle switches to the opposite of what they see, and switching
  back to their system's own scheme forgets the choice instead of pinning it.

  A form, so it works without script — but only the stylesheet knows which
  scheme the system is in. So there is one submit button per system scheme,
  each posting what toggling means there (Page.ThemeToggle), and base.css
  shows the one that applies. Each button carries both names and both icons;
  base.css keeps the pair for the theme on screen, and display:none takes the
  other name out of the accessibility tree too, so the button's name is right
  after a system change or an enhanced toggle with no script touching it.
  web/assets/ts/theme.ts applies a choice without the reload.

  Takes a dict of Page, Class and an optional Return (default Page.Path, in
  the page's language).
  Class goes on each <timlee-icon-button> so each surface can place it.
*/ -}}
{{ define "theme-toggle" }}
{{- $p := .Page -}}
<form class="theme-form" method="post" action="/theme" data-theme-toggle>
  <input type="hidden" name="returnTo" value="{{ or .Return (href $p.L $p.Path) }}" />
  <timlee-icon-button{{ with .Class }} class="{{ . }}"{{ end }} data-system="light">
    <button type="submit" name="theme" value="{{ $p.ThemeToggle "light" }}">{{ template "theme-toggle-face" $p }}</button>
  </timlee-icon-button>
  <timlee-icon-button{{ with .Class }} class="{{ . }}"{{ end }} data-system="dark">
    <button type="submit" name="theme" value="{{ $p.ThemeToggle "dark" }}">{{ template "theme-toggle-face" $p }}</button>
  </timlee-icon-button>
</form>
{{ end }}

{{ define "theme-toggle-face" }}
      <svg class="to-dark" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
      </svg>
      <svg class="to-light" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
      <span class="to-dark visually-hidden">{{ t .L "common.theme.switchDark" }}</span>
      <span class="to-light visually-hidden">{{ t .L "common.theme.switchLight" }}</span>
{{ end }}
