{{- /* The Timlee wordmark. Takes a dict of Href, Class and L. */ -}}
{{ define "logo" }}
<a href="{{ .Href }}" class="{{ .Class }}">
  {{ template "mark" }}
  <span>Timlee</span><span class="visually-hidden"> {{ t .L "common.logo.home" }}</span>
</a>
{{ end }}

{{- /* The mark on its own, for places that already have a label. */ -}}
{{ define "mark" }}
<svg viewBox="0 0 32 32" aria-hidden="true">
  <rect width="32" height="32" rx="7" />
  <path d="M8 9h16v3h-6.5v11h-3V12H8z" />
</svg>
{{ end }}
