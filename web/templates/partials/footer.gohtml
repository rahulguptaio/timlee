{{- /*
  The site footer.

  Groups come from the server, so a new destination is one entry in Go rather
  than four copies of an <li> across three templates.
*/ -}}
{{ define "footer" }}
<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      {{ template "logo" (dict "Href" (href .L "/") "Class" "logo" "L" .L) }}
      <p>{{ .Site.Tagline }}</p>
    </div>

    <nav class="footer-nav" aria-label="{{ t .L "common.footer.label" }}">
      {{ range .Site.Footer }}
      <div class="footer-group">
        <h2>{{ .Title }}</h2>
        <ul>
          {{ range .Links }}
          <li>
            <a href="{{ href $.L .Href }}"{{ if .External }} target="_blank" rel="noopener noreferrer"{{ end }}>{{ .Label }}</a>
          </li>
          {{ end }}
        </ul>
      </div>
      {{ end }}
      {{- template "locale-switcher" . }}
    </nav>
  </div>

  <div class="wrap footer-legal">
    <p>&copy; {{ .Year }} {{ .Site.Legal }}</p>
  </div>
</footer>
{{ end }}
