{{- /*
  Audit log: who did what, to what, and when, newest first. The period is a
  set of links and the other filters a GET form, so a filtered page is a URL
  that can be shared, and the exports carry the same filters. People and
  targets are named as they were when each event was recorded.
*/ -}}
{{ define "content" }}
{{- $d := .Data -}}
{{- $s := $d.Shell -}}
<header class="st-head">
  <h1>{{ t .L "settings.audit.title" }}</h1>
  <p>{{ if $s.Org }}{{ t .L "settings.audit.ledeOrg" "org" $s.Org.Name }}{{ else }}{{ t .L "settings.audit.lede" }}{{ end }}</p>
</header>

{{ template "settings-outcome" . }}

{{ if not $s.Org }}
<section class="st-section">
  <p>{{ t .L "settings.audit.noOrg" }}</p>
</section>
{{ else if not $s.CanManage }}
<section class="st-section">
  {{ template "settings-ask" (dict "L" $.L "Lead" (t $.L "settings.audit.restricted") "Admins" $d.Admins) }}
</section>
{{ else }}
<section class="st-section">
  <h2 id="audit-events" class="visually-hidden">{{ t .L "settings.audit.events" }}</h2>
  <search aria-label="{{ t .L "settings.audit.filterLabel" }}" class="st-audit-filters">
    <nav class="st-filters" aria-label="{{ t $.L "settings.audit.periodLabel" }}">
      <ul>
        {{- range $d.Periods }}
        <li><a href="{{ .Href }}"{{ if .Current }} aria-current="page"{{ end }}>{{ .Label }}</a></li>
        {{- end }}
      </ul>
    </nav>
    <form class="st-filter" method="get" action="/settings/audit">
      {{ if and $d.Filters.Period (not $d.Filters.Custom) }}<input type="hidden" name="period" value="{{ $d.Filters.Period }}" />{{ end }}
      <timlee-select>
        <label for="audit-category">{{ t $.L "settings.audit.activity" }}</label>
        <select id="audit-category" name="category">
          {{ range $d.Categories }}<option value="{{ .Value }}"{{ if .Selected }} selected{{ end }}>{{ .Label }}</option>{{ end }}
        </select>
      </timlee-select>
      <timlee-select>
        <label for="audit-actor">{{ t $.L "settings.audit.doneBy" }}</label>
        <select id="audit-actor" name="actor">
          {{ range $d.Actors }}<option value="{{ .Value }}" dir="auto"{{ if .Selected }} selected{{ end }}>{{ .Label }}</option>{{ end }}
        </select>
      </timlee-select>
      <timlee-input class="st-filter-target">
        <label for="audit-target">{{ t $.L "settings.audit.targetLabel" }}</label>
        <input id="audit-target" name="target" type="search" value="{{ $d.Filters.Target }}" maxlength="200" autocomplete="off" spellcheck="false" aria-describedby="audit-target-hint" dir="auto" />
        <p data-hint id="audit-target-hint">{{ t $.L "settings.audit.targetHint" }}</p>
      </timlee-input>
      {{- $fromError := $s.ErrorFor "audit-from" -}}
      {{- $toError := $s.ErrorFor "audit-to" }}
      <fieldset class="st-range" aria-describedby="audit-range-hint">
        <legend>{{ t $.L "settings.audit.rangeLegend" }}</legend>
        <p class="st-legend-hint" id="audit-range-hint">{{ t $.L "settings.audit.rangeHint" }}</p>
        <timlee-input{{ if $fromError }} invalid{{ end }}>
          <label for="audit-from">{{ t $.L "settings.audit.from" }}</label>
          <input id="audit-from" name="from" type="date" value="{{ $d.Filters.From }}"{{ if $fromError }} aria-describedby="audit-from-error" aria-invalid="true"{{ end }} />
          <p data-error id="audit-from-error">{{ template "settings-error" (dict "L" $.L "Message" $fromError) }}</p>
        </timlee-input>
        <timlee-input{{ if $toError }} invalid{{ end }}>
          <label for="audit-to">{{ t $.L "settings.audit.to" }}</label>
          <input id="audit-to" name="to" type="date" value="{{ $d.Filters.To }}"{{ if $toError }} aria-describedby="audit-to-error" aria-invalid="true"{{ end }} />
          <p data-error id="audit-to-error">{{ template "settings-error" (dict "L" $.L "Message" $toError) }}</p>
        </timlee-input>
      </fieldset>
      <div class="st-filter-actions">
        <timlee-button variant="secondary"><button type="submit">{{ t $.L "settings.audit.applyFilters" }}</button></timlee-button>
        {{ if $d.Filtered }}<timlee-button variant="ghost"><a href="/settings/audit">{{ t $.L "settings.audit.clearFilters" }}</a></timlee-button>{{ end }}
      </div>
    </form>
  </search>

  {{ with $d.LoadError }}<timlee-alert tone="danger"><p>{{ . }}</p></timlee-alert>{{ end }}

  {{ with $d.Kept }}
  <p class="st-quiet st-retention">{{ t $.L "settings.audit.retention" "start" .Date }}</p>
  {{ end }}

  {{ if $d.Rows }}
  <div class="st-export">
    <p>{{ t $.L "settings.audit.exportLead" "count" $d.Total }}</p>
    <timlee-button variant="secondary" size="sm"><a href="{{ $d.ExportCSV }}" download>{{ t $.L "settings.audit.exportCsv" }}</a></timlee-button>
    <timlee-button variant="secondary" size="sm"><a href="{{ $d.ExportJSON }}" download>{{ t $.L "settings.audit.exportJson" }}</a></timlee-button>
  </div>
  {{ if $d.ExportCapped }}<p class="st-quiet">{{ t $.L "settings.audit.exportCapped" "cap" $d.ExportCap }}</p>{{ end }}

  <timlee-table label="{{ t $.L "settings.audit.title" }}" class="st-cards" density="compact">
    <table>
      <caption>{{ if $d.Filtered }}{{ t $.L "settings.audit.captionFiltered" "from" $d.From "to" $d.To "total" $d.Total }}{{ else }}{{ t $.L "settings.audit.caption" "from" $d.From "to" $d.To "total" $d.Total }}{{ end }}</caption>
      <thead>
        <tr>
          <th scope="col">{{ t $.L "settings.audit.when" }}</th>
          <th scope="col">{{ t $.L "settings.audit.actor" }}</th>
          <th scope="col">{{ t $.L "settings.audit.action" }}</th>
          <th scope="col">{{ t $.L "settings.audit.target" }}</th>
        </tr>
      </thead>
      <tbody>
        {{ range $d.Rows }}
        <tr>
          <td class="st-when">
            <span class="st-label" aria-hidden="true">{{ t $.L "settings.audit.when" }}</span>
            <span><time datetime="{{ .When.ISO }}">{{ .When.Ago }}</time> <span class="st-quiet st-sub st-nowrap">{{ .When.Full }}</span></span>
          </td>
          <td><span class="st-label" aria-hidden="true">{{ t $.L "settings.audit.actor" }}</span><span><bdi dir="auto">{{ .Actor }}</bdi>{{ with .Email }} <span class="st-quiet st-sub"><bdi dir="ltr">{{ . }}</bdi></span>{{ end }}</span></td>
          <td class="st-primary-cell"><span>{{ .Action }}{{ with .Details }} <span class="st-quiet st-sub">{{ . }}</span>{{ end }}</span></td>
          <td><span class="st-label" aria-hidden="true">{{ t $.L "settings.audit.target" }}</span><span class="st-target"><bdi dir="auto">{{ .Target }}</bdi></span></td>
        </tr>
        {{ end }}
      </tbody>
    </table>
  </timlee-table>

  {{ if $d.Pages }}
  <timlee-pagination>
    <nav aria-label="{{ t $.L "settings.audit.pagesLabel" }}">
      {{ with $d.Prev }}<a href="{{ . }}" rel="prev">{{ t $.L "settings.table.previous" }}</a>{{ end }}
      {{ range $d.Pages }}
      {{ if .Gap }}<span data-ellipsis>&hellip;</span>{{ else }}<a href="{{ .Href }}"{{ if .Current }} aria-current="page"{{ end }}><span class="visually-hidden">{{ t $.L "settings.table.page" }} </span>{{ .N }}</a>{{ end }}
      {{ end }}
      {{ with $d.Next }}<a href="{{ . }}" rel="next">{{ t $.L "settings.table.next" }}</a>{{ end }}
    </nav>
  </timlee-pagination>
  {{ end }}

  {{ else if not $d.LoadError }}
  <timlee-empty-state>
    {{ if $d.Filtered }}
    <h3>{{ t $.L "settings.audit.filteredEmptyTitle" }}</h3>
    <p>{{ t $.L "settings.audit.filteredEmptyBody" }}</p>
    <timlee-button variant="secondary"><a href="/settings/audit">{{ t $.L "settings.audit.clearFilters" }}</a></timlee-button>
    {{ else }}
    <h3>{{ t $.L "settings.audit.emptyTitle" }}</h3>
    <p>{{ t $.L "settings.audit.emptyBody" }}</p>
    <p class="st-empty-links"><a href="/settings/members#invite-email">{{ t $.L "settings.audit.emptyInvite" }}</a> <a href="/settings/keys#key-label">{{ t $.L "settings.audit.emptyKey" }}</a></p>
    {{ end }}
  </timlee-empty-state>
  {{ end }}
</section>
{{ end }}
{{ end }}
