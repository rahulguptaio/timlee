{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Timlee",
  "mainBinaryName": "Timlee",
  "version": "0.1.0",
  "identifier": "io.timlee.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'",
      "capabilities": ["local-pages"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "category": "DeveloperTool",
    "publisher": "Timlee",
    "homepage": "https://timlee.example",
    "shortDescription": "Timlee for macOS and Windows",
    "longDescription": "Timlee turns written prompts into Svelte apps built on a shared design system. This app is a native window around the hosted Timlee site.",
    "copyright": "© 2026 Timlee",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://timlee.example/desktop/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
